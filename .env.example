# The app loads this directory's .env; exported variables take precedence.
SUPABASE_URL=
# Optional: legacy account APIs only, not text-first onboarding.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional direct/session-pooler URL for applying migrations with psql.
DATABASE_URL=
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_PHONE_NUMBER=
# Generate locally and configure the same secret on the receive webhook.
SENDBLUE_WEBHOOK_SECRET=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-6.1-sol
# Exact origins allowed to call the API from a browser; comma separated.
APP_ORIGINS=http://localhost:3000
# Public HTTPS base URL, used for webhook setup after deployment.
APP_URL=

# Migration only; copy the connection host from Supabase Connect.
SUPABASE_DATABASE_PASSWORD=
SUPABASE_DATABASE_HOST=
SUPABASE_DATABASE_USER=

# Optional: Composio account integrations, scoped to each phone workspace.
# Key permissions: Session management read and write + Session tool execution write only.
# Configure Gmail and GitHub auth configs in the same Composio project.
COMPOSIO_API_KEY=
# Optional for account watches: webhook subscription signing secret from Composio.
# Watches also require Triggers read/write, Webhooks read/write (setup),
# and Connected accounts read-only in addition to the session permissions above.
COMPOSIO_WEBHOOK_SECRET=
